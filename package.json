{
  "name": "config-attestation",
  "version": "1.0.0",
  "description": "[![config](https://github.com/brave/config-attestation/actions/workflows/config.yml/badge.svg)](https://github.com/brave/config-attestation/actions/workflows/config.yml)",
  "main": "index.js",
  "scripts": {
    "start": "pnpm run build:prism && pnpm run start:tailwind",
    "build": "pnpm run build:prism && pnpm run build:tailwind",
    "build:prism": "cp node_modules/prismjs/prism.js site/js/",
    "start:tailwind": "pnpm exec tailwindcss -i ./src/main.css -o ./site/css/main.css --watch",
    "build:tailwind": "pnpm exec tailwindcss -i ./src/main.css -o ./site/css/main.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brave/config-attestation.git"
  },
  "author": "",
  "license": "MPL-2.0",
  "dependencies": {
    "@brave/leo": "github:brave/leo#53850d6d6b12ea0e675dba71c8460f51b22bf90a",
    "prismjs": "1.30.0",
    "tailwindcss": "3.4.19"
  },
  "packageManager": "pnpm@11.26.0+sha512.fc0e2bf890b9f983611f1ab68c0637bce914390653699f83c1a78b005ed25f2c81e77920c8fd8eee2ecf0b58b28cdcb00a84d97f69bcf7c56b2f344710238664"
}
